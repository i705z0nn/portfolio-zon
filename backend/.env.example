# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/portfolio?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="1d"

# Admin credentials (used for seeding)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Ably (Real-time)
ABLY_API_KEY="your-ably-api-key"

# App
PORT=3001

# Seed endpoint secret (POST /api/seed/experiences with header x-seed-secret)
SEED_SECRET="your-seed-secret-change-this"
